--- /dev/null
+++ b/lib/assessment-evidence-contract.mjs
@@ -0,0 +1,20 @@
+import {calculateScores,COMPETENCIES} from './assessment-scoring.mjs';
+import {runFramework} from './cv-fault-framework.mjs';
+export const EVIDENCE_CONTRACT_VERSION='evidence-only-v1';
+export const APPLICATION_CRITERIA=['contribution','analysis','outputs','roleRelevance','specificity','clarity'];
+export function evidenceContract(ids){const quotes={type:'array',items:{type:'string',enum:ids}};return {type:'object',additionalProperties:false,required:['applicationCriteria','competencies'],properties:{applicationCriteria:{type:'array',minItems:6,maxItems:6,items:{type:'object',additionalProperties:false,required:['name','points','quotes'],properties:{name:{type:'string',enum:APPLICATION_CRITERIA},points:{type:'integer',minimum:0,maximum:5},quotes}}},competencies:{type:'array',minItems:7,maxItems:7,items:{type:'object',additionalProperties:false,required:['name','score','quotes'],properties:{name:{type:'string',enum:COMPETENCIES},score:{type:'integer',minimum:0,maximum:100},quotes}}}}};}
+export const EVIDENCE_RUBRIC=`Return six applicationCriteria: contribution, analysis, outputs, roleRelevance, specificity, clarity. Score each 0–5: 0 absent; 1 vague mention; 2 identifiable task; 3 specific personal action; 4 action with concrete analysis/output; 5 clear substantiated action, output and relevance. Every nonzero mark requires an exact evidence catalogue ID.
+Return seven competencies: Analytical ability, Teamwork, Communication, Leadership, Resilience, Commercial awareness, Technical readiness. Score 0–100 in whole numbers: 0 absent; 1–29 vague mention; 30–54 relevant activity but unclear contribution; 55–69 specific personal action with material gaps; 70–89 strong specific action, method and output; 90–100 exceptional substantiated result and reflection. Every nonzero mark requires an exact catalogue ID. If evidence is absent, score 0 with empty quotes. Never invent experience to fill a slot.
+An education-only CV, no internship, no employment, or a skills-only CV is a valid starting point. Score only what is actually supplied. Transferable activities count; financial experience is not required for transferable credit. No university prestige points and no invented hiring policies. Explicit ongoing weekly work alongside university is balancing-commitments evidence for Resilience (30–54 if approach is unclear, higher only with supplied method/outcome); never infer adversity or success. Self-reported finance knowledge does not alter marks. Tests are graded separately by the server. Do not return narrative, diagnoses or rewrites: the fixed framework supplies findings.`;
+function resolveQuotes(items,catalog,cv){const quotes=new Map(catalog.map(x=>[x.id,x.quote]));if(!Array.isArray(items))return items;return items.map(item=>({...item,quotes:Array.isArray(item.quotes)?item.quotes.map(id=>{if(quotes.has(id))return quotes.get(id);if(typeof id==='string'&&id.trim()&&cv.includes(id))return id;throw Error('Scored evidence must refer to this CV catalogue.');}):item.quotes}));}
+export function evidenceAssessment(draft,{catalog,cvText,profile={},ats,quiz}){
+ if(!draft||typeof draft!=='object')throw Error('Submit the evidence assessment.');
+ const criteria=resolveQuotes(draft.applicationCriteria,catalog,cvText),competencies=resolveQuotes(draft.competencies,catalog,cvText);
+ // Reasons are source descriptions, not new judgements. Marks and complete source
+ // quotes still pass the same numeric/evidence validators before saving.
+ const analysis={applicationCriteria:criteria,competencies:Array.isArray(competencies)?competencies.map(c=>({...c,reason:c.quotes?.length?'CV evidence: “'+c.quotes[0]+'”':'No supporting example for '+String(c.name||'this competency').toLowerCase()+' is recorded.',detail:c.quotes?.[0]||'',nextStep:'Use a real example to explain your action and what changed.'})):competencies};
+ const scored=calculateScores(analysis,ats,quiz,cvText),framework=runFramework(cvText,{firm:profile.targetFirm||'your target firm',route:profile.targetSector||profile.targetDivision||''});
+ const best=(scored.competencies||[]).slice().sort((a,b)=>b.score-a.score).find(c=>c.score>0&&c.quotes.length),support=best?.quotes[0]||'';
+ return {...scored,evidenceContractVersion:EVIDENCE_CONTRACT_VERSION,deskSummary:support?'Your CV records: '+support:'Your CV gives your starting information. Add a real work, study or activity example to demonstrate your contribution.',skimNote:framework.reasons[0].text,summaryDetail:best?.detail||'',priorities:framework.reasons.map(r=>({title:r.text.split(/\s+/).slice(0,10).join(' '),description:r.text,detail:framework.teaserLine?.role||'',competencies:['Analytical ability']})),weakLines:framework.allFlaggedLines.map(line=>({original:line.text,issue:line.why,severity:line.severity>=12?3:line.severity>=6?2:1})),cvPreview:framework.teaserLine?{original:framework.teaserLine.text,issue:framework.teaserLine.why,source:framework.teaserLine.role||'',structure:''}:undefined};
+}
+export const transientAssessmentError=error=>[408,409,429,500,502,503,504].includes(error?.status)||/Timeout|Connection/.test(error?.name||'');
