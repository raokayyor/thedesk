+import test from 'node:test';import assert from 'node:assert/strict';
+import {evidenceContract,evidenceAssessment,APPLICATION_CRITERIA,transientAssessmentError} from '../lib/assessment-evidence-contract.mjs';import {COMPETENCIES} from '../lib/assessment-scoring.mjs';import {getEvidenceCatalog} from '../lib/full-cycle-contract.mjs';import {shortSupportingRewrite,rewriteSimilarity} from '../lib/free-line-rewrite.mjs';import {runFramework} from '../lib/cv-fault-framework.mjs';
+const cv='Tom Lee\nEDUCATION\nUniversity of Kent, BA History, 2024-2027.\nSKILLS\nMicrosoft Office, hard working, team player\nInterests: reading, gym',catalog=getEvidenceCatalog(cv),empty=()=>({applicationCriteria:APPLICATION_CRITERIA.map(name=>({name,points:0,quotes:[]})),competencies:COMPETENCIES.map(name=>({name,score:0,quotes:[]}))}),context={cvText:cv,catalog,profile:{targetSector:'General Finance'},ats:{score:20},quiz:{numericalCorrect:1,commercialCorrect:1}};
+test('education-only CV is a valid result without four named work examples, a preview or AI prose',()=>{const draft=empty(),r=evidenceAssessment(draft,context);assert.equal(r.overallScore,6);assert.ok(r.evidenceContractVersion);assert.deepEqual(r.applicationCriteria,draft.applicationCriteria);assert.ok(r.competencies.every(c=>c.score===0&&c.quotes.length===0));assert.deepEqual(r.priorities.map(p=>p.description),runFramework(cv,{route:'General Finance',firm:'your target firm'}).reasons.map(r=>r.text));assert.deepEqual(evidenceAssessment(draft,context),r);assert.deepEqual(Object.keys(evidenceContract(catalog.map(x=>x.id)).properties),['applicationCriteria','competencies']);});
+test('invalid marks, duplicate categories and invented/foreign evidence still fail; narrative cannot change scores',()=>{for(const change of [d=>{d.competencies[0].score=50},d=>{d.applicationCriteria[0].points=6},d=>{d.competencies[0].quotes=['OTHER_CV']},d=>{d.competencies[0].name='Invented skill'},d=>{d.applicationCriteria[1].name=d.applicationCriteria[0].name}]){const d=empty();change(d);assert.throws(()=>evidenceAssessment(d,context));}const d=empty();d.deskSummary='INVENTED_EMPLOYER';d.weakLines=[{original:'INVENTED_LINE'}];assert.doesNotMatch(JSON.stringify(evidenceAssessment(d,context)),/INVENTED/);});
+test('exact source IDs resolve and only actual answers change test points',()=>{const d=empty();d.applicationCriteria[0]={name:'contribution',points:1,quotes:['E5']};const a=evidenceAssessment(d,context),b=evidenceAssessment(d,{...context,quiz:{numericalCorrect:5,commercialCorrect:5}});assert.deepEqual(a.applicationCriteria[0].quotes,[catalog.find(x=>x.id==='E5').quote]);assert.equal(b.overallScore-a.overallScore,16);assert.equal(b.cvEvidenceScore,a.cvEvidenceScore);});
+test('short supporting fragment gets a materially different, incomplete scaffold without inventing facts',()=>{const original='Helped with bookkeeping',r=shortSupportingRewrite(original,original);assert.ok(r);assert.ok(rewriteSimilarity(original,r.line)<.85);assert.equal(r.needsFacts,true);assert.match(r.line,/Contributed to bookkeeping/);assert.match(r.line,/\[what you personally did\]/);assert.doesNotMatch(r.line.replace(/\[[^\]]*\]/g,''),/client|Excel|led|saved|\d/);assert.equal(shortSupportingRewrite('Responsible for £4m in revenue','Responsible for £4m in revenue'),null);assert.equal(shortSupportingRewrite(original,'A different source'),null);});
+test('only transient provider errors qualify for the bounded retry',()=>{assert.equal(transientAssessmentError({status:503}),true);assert.equal(transientAssessmentError({name:'APIConnectionTimeoutError'}),true);assert.equal(transientAssessmentError({status:400}),false);});
