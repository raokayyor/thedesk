{
  "functions": {
    "api/pilot-access.js": {
      "includeFiles": "samples/amelia-report-v3-preview.json",
      "maxDuration": 300
    },
    "api/analyse-mot.js": {
      "maxDuration": 300
    },
    "api/full-cycle.js": {
      "maxDuration": 300
    },
    "api/generate-cv.js": {
      "maxDuration": 60
    },
    "api/knowledge.js": {
      "maxDuration": 120
    },
    "api/interview-feedback.js": {
      "maxDuration": 120
    },
    "api/interview-transcribe.js": {
      "maxDuration": 60
    },
    "api/extract-cv.js": {
      "maxDuration": 60
    },
    "api/test-run.js": {
      "maxDuration": 300
    },
    "api/deep-assessment.js": {
      "maxDuration": 300
    },
    "api/result-rewrite.js": {
      "maxDuration": 60,
      "includeFiles": "samples/amelia-report-v3-preview.json"
    },
    "api/live-session-mail.js": {
      "maxDuration": 300,
      "includeFiles": "live-sessions.js"
    },
    "api/live-sessions.js": {
      "includeFiles": "live-sessions.js"
    },
    "api/member-library.js": {
      "includeFiles": "{library.html,video-library.html,video-library.json,interview-brain-teasers.js}"
    },
    "api/programmes-cron.js": {
      "maxDuration": 300
    },
    "api/tool-entry.js": {
      "includeFiles": "*.html"
    },
    "api/desk-home.js": {
      "includeFiles": "samples/amelia-report-v3-preview.json"
    }
  },
  "crons": [
    {
      "path": "/api/result-email-cron",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/markets-snapshot-cron",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/live-session-mail",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/programmes-cron",
      "schedule": "0 5,6 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/try.html",
      "destination": "/api/legacy-entry"
    },
    {
      "source": "/:page([^/]+\\.html)",
      "has": [
        {
          "type": "query",
          "key": "taster"
        }
      ],
      "destination": "/api/legacy-entry?path=:page"
    },
    {
      "source": "/crib-sheet.html",
      "destination": "/api/tool-entry?file=crib-sheet.html"
    },
    {
      "source": "/members-only.html",
      "destination": "/api/tool-entry?file=members-only.html"
    },
    {
      "source": "/interview.html",
      "destination": "/api/tool-entry?file=interview.html"
    },
    {
      "source": "/interview-start.html",
      "destination": "/api/tool-entry?file=interview-start.html"
    },
    {
      "source": "/tests.html",
      "destination": "/api/tool-entry?file=tests.html"
    },
    {
      "source": "/practice-tests.html",
      "destination": "/api/tool-entry?file=practice-tests.html"
    },
    {
      "source": "/applications.html",
      "destination": "/api/tool-entry?file=applications.html"
    },
    {
      "source": "/application-help.html",
      "destination": "/api/tool-entry?file=application-help.html"
    },
    {
      "source": "/cv.html",
      "destination": "/api/tool-entry?file=cv.html"
    },
    {
      "source": "/cv-editor.html",
      "destination": "/api/tool-entry?file=cv-editor.html"
    },
    {
      "source": "/assessment-centre.html",
      "destination": "/api/tool-entry?file=assessment-centre.html"
    },
    {
      "source": "/group-exercise.html",
      "destination": "/api/tool-entry?file=group-exercise.html"
    },
    {
      "source": "/case-study.html",
      "destination": "/api/tool-entry?file=case-study.html"
    },
    {
      "source": "/inbox-exercise.html",
      "destination": "/api/tool-entry?file=inbox-exercise.html"
    },
    {
      "source": "/ac-crib.html",
      "destination": "/api/tool-entry?file=ac-crib.html"
    },
    {
      "source": "/firm-interview-guides.html",
      "destination": "/api/tool-entry?file=firm-interview-guides.html"
    },
    {
      "source": "/saved-answers.html",
      "destination": "/api/tool-entry?file=saved-answers.html"
    },
    {
      "source": "/your-story.html",
      "destination": "/api/tool-entry?file=your-story.html"
    },
    {
      "source": "/library.html",
      "destination": "/api/tool-entry?file=library.html"
    },
    {
      "source": "/practitioners.html",
      "destination": "/api/tool-entry?file=practitioners.html"
    },
    {
      "source": "/lib/aptitude-practice-extra.mjs",
      "destination": "/api/aptitude-practice?view=blocked"
    },
    {
      "source": "/lib/aptitude-practice-data.mjs",
      "destination": "/api/aptitude-practice?view=blocked"
    },
    {
      "source": "/lib/reasoning-practice-data.mjs",
      "destination": "/api/aptitude-practice?view=blocked"
    },
    {
      "source": "/video-library.html",
      "destination": "/api/member-library?asset=videos"
    },
    {
      "source": "/video-library.json",
      "destination": "/api/member-library?asset=videoData"
    },
    {
      "source": "/interview-brain-teasers.js",
      "destination": "/api/member-library?asset=brain"
    }
  ],
  "redirects": [
    {
      "source": "/mentor.html",
      "destination": "/one-to-one.html",
      "permanent": false
    },
    {
      "source": "/book-call.html",
      "destination": "/one-to-one.html",
      "permanent": false
    }
  ],
  "proxy": {
    "entrypoint": "entry-proxy.js",
    "matcher": [
      "/((?!api/).*\\.html)"
    ]
  },
  "buildCommand": "node scripts/build-amelia-showcase.mjs --check",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:page(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:asset(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:asset(.*\\.mjs)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:asset(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
